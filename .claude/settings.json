{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PROJECT_DIR:-.}/tools/hooks/ruff-fix-hook.sh\"",
            "timeout": 30,
            "statusMessage": "ruff + black"
          }
        ]
      }
    ]
  }
}
